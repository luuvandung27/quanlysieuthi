@model IReadOnlyList<QuanLySieuThi.Models.Entities.SalesInvoice>
@{ ViewData["Title"] = User.IsInRole(RoleNames.Admin) ? "Hóa đơn bán hàng" : "Hóa đơn của tôi"; }
<div class="page-heading"><h1>@ViewData["Title"]</h1><a class="btn btn-primary" asp-action="Index">Bán hàng</a></div>
<section class="panel p-3">
    <form method="get" asp-action="Invoices" class="toolbar">
        <input class="form-control" name="search" value="@ViewData["Search"]" placeholder="Mã hóa đơn" aria-label="Mã hóa đơn" />
        <button class="btn btn-outline-secondary">Tìm kiếm</button>
    </form>
    <div class="table-responsive">
        <table class="table">
            <thead><tr><th>Mã hóa đơn</th><th>Ngày giờ lập (UTC+7)</th><th>Khách hàng</th><th>Thanh toán</th><th>Trạng thái</th><th>Tổng tiền</th><th></th></tr></thead>
            <tbody>
            @if (Model.Count == 0)
            {
                <tr><td colspan="7" class="text-center text-muted">Không tìm thấy hóa đơn.</td></tr>
            }
            @foreach (var invoice in Model)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@invoice.SalesInvoiceId">@invoice.InvoiceNo</a></td>
                    <td class="text-nowrap"><partial name="_VietnamDateTime" model="invoice.CreatedAt" /></td>
                    <td>@(invoice.Customer?.FullName ?? "Khách lẻ")</td>
                    <td>@(invoice.PaymentMethod == "Cash" ? "Tiền mặt" : invoice.PaymentMethod)</td>
                    <td><partial name="_InvoiceStatus" model="invoice.Status" /></td>
                    <td class="text-nowrap">@invoice.TotalAmount.ToString("N2") ₫</td>
                    <td>
                        @if (invoice.Status == "Completed")
                        {
                            <a asp-action="Print" asp-route-id="@invoice.SalesInvoiceId" target="_blank" rel="noopener">In</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
