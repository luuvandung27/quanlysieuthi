@model QuanLySieuThi.Models.Entities.SalesInvoice
@{
    Layout = null;
    var createdAt = Model.CreatedAt.AddHours(7);
    var cashier = Model.CashierUser.Employee?.FullName ?? Model.CashierUser.Username;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hóa đơn @Model.InvoiceNo</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; padding: 24px; color: #172033; font: 14px/1.45 Arial, sans-serif; background: #f3f5f8; }
        .receipt { width: 80mm; max-width: 100%; margin: 0 auto; padding: 22px; background: #fff; }
        .center { text-align: center; }
        h1 { margin: 0 0 4px; font-size: 20px; letter-spacing: .5px; }
        h2 { margin: 5px 0 14px; font-size: 15px; font-weight: 500; }
        .muted { color: #667085; font-size: 12px; }
        .meta { margin: 16px 0; padding: 12px 0; border-top: 1px dashed #aab2bf; border-bottom: 1px dashed #aab2bf; }
        .meta div { display: flex; justify-content: space-between; gap: 10px; margin: 4px 0; }
        table { width: 100%; border-collapse: collapse; font-size: 12px; }
        th { padding: 7px 2px; border-bottom: 1px solid #cbd1da; text-align: left; }
        td { padding: 7px 2px; vertical-align: top; }
        .right { text-align: right; white-space: nowrap; }
        .totals { margin-top: 12px; padding-top: 10px; border-top: 1px dashed #aab2bf; }
        .totals div { display: flex; justify-content: space-between; gap: 10px; margin: 6px 0; }
        .grand { font-size: 17px; font-weight: 700; }
        .actions { display: flex; justify-content: center; gap: 8px; margin: 18px auto; }
        button, a { padding: 9px 14px; border: 0; border-radius: 6px; color: #fff; background: #245dcc; text-decoration: none; cursor: pointer; font-size: 14px; }
        a { background: #596579; }
        .thanks { margin-top: 22px; text-align: center; }
        @@media print {
            body { padding: 0; background: #fff; }
            .receipt { width: 80mm; max-width: none; margin: 0; padding: 4mm; }
            .actions { display: none !important; }
            @@page { size: 80mm auto; margin: 3mm; }
        }
    </style>
</head>
<body>
    <main class="receipt">
        <header class="center">
            <h1>SIÊU THỊ MINI</h1>
            <h2>HÓA ĐƠN BÁN HÀNG</h2>
            <div class="muted">Cảm ơn quý khách đã mua hàng</div>
        </header>
        <section class="meta">
            <div><span>Mã hóa đơn</span><strong>@Model.InvoiceNo</strong></div>
            <div><span>Ngày lập</span><strong>@createdAt.ToString("dd/MM/yyyy HH:mm")</strong></div>
            <div><span>Thu ngân</span><strong>@cashier</strong></div>
            <div><span>Khách hàng</span><strong>@(Model.Customer?.FullName ?? "Khách lẻ")</strong></div>
            @if (!string.IsNullOrWhiteSpace(Model.Customer?.Phone))
            {
                <div><span>Điện thoại</span><strong>@Model.Customer.Phone</strong></div>
            }
        </section>
        <table>
            <thead>
                <tr><th>Sản phẩm</th><th class="right">SL</th><th class="right">Đơn giá</th><th class="right">T.Tiền</th></tr>
            </thead>
            <tbody>
            @foreach (var line in Model.Details)
            {
                <tr>
                    <td>@line.ProductNameSnapshot<br /><span class="muted">@line.SkuSnapshot</span></td>
                    <td class="right">@line.Quantity.ToString("0.###")</td>
                    <td class="right">@line.UnitPrice.ToString("N0")</td>
                    <td class="right">@line.LineTotal.ToString("N0")</td>
                </tr>
            }
            </tbody>
        </table>
        <section class="totals">
            <div><span>Tạm tính</span><strong>@Model.Subtotal.ToString("N0") ₫</strong></div>
            <div><span>Giảm giá</span><strong>-@Model.DiscountAmount.ToString("N0") ₫</strong></div>
            <div class="grand"><span>Tổng cộng</span><strong>@Model.TotalAmount.ToString("N0") ₫</strong></div>
            <div><span>Thanh toán</span><strong>@(Model.PaymentMethod == "Cash" ? "Tiền mặt" : Model.PaymentMethod)</strong></div>
            @if (Model.PaymentMethod == "Cash")
            {
                <div><span>Khách đưa</span><strong>@Model.CashReceived.ToString("N0") ₫</strong></div>
                <div><span>Tiền thừa</span><strong>@Model.ChangeAmount.ToString("N0") ₫</strong></div>
            }
        </section>
        <footer class="thanks">
            <strong>HẸN GẶP LẠI QUÝ KHÁCH!</strong>
            <div class="muted">Hóa đơn được lưu trên hệ thống.</div>
        </footer>
    </main>
    <div class="actions">
        <button type="button" onclick="window.print()">In hóa đơn</button>
        <a href="javascript:window.close()">Đóng</a>
    </div>
</body>
</html>
