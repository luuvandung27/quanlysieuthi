@model IReadOnlyList<QuanLySieuThi.Models.SupplierListItemViewModel>
@{ ViewData["Title"] = "Nhà cung cấp"; }
<div class="page-heading"><div><p class="eyebrow">QUẢN TRỊ ĐỐI TÁC</p><h1>Nhà cung cấp</h1><p class="text-muted">Quản lý danh sách đối tác và thông tin liên hệ.</p></div><a asp-action="SupplierCreate" class="btn btn-primary">＋ Thêm nhà cung cấp</a></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success py-2">@success</div> }
<section class="panel table-panel"><form asp-action="Suppliers" method="get" class="toolbar"><div class="search-box"><span>⌕</span><input name="search" value="@ViewBag.Search" placeholder="Tìm tên, mã hoặc số điện thoại" /></div><label class="include-inactive"><input type="checkbox" name="includeInactive" value="true" checked="@(ViewBag.IncludeInactive == true)" /> Hiện đã ngừng</label><button class="btn btn-outline-secondary">Lọc</button></form>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>Mã NCC</th><th>Nhà cung cấp</th><th>Liên hệ</th><th>Địa chỉ</th><th>Phiếu nhập</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@if (Model.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-4">Chưa có nhà cung cấp phù hợp.</td></tr> }
@foreach (var supplier in Model)
{
    <tr><td>@supplier.SupplierCode</td><td><strong>@supplier.Name</strong></td><td>@(supplier.Phone ?? "—")<small class="d-block text-muted">@(supplier.Email ?? "")</small></td><td>@(supplier.Address ?? "—")</td><td>@supplier.PurchaseCount</td><td><span class="status-pill @(supplier.IsActive ? "success" : "muted")">@(supplier.IsActive ? "Đang hợp tác" : "Đã ngừng")</span></td><td><div class="row-actions"><a asp-action="SupplierEdit" asp-route-id="@supplier.SupplierId" class="btn btn-sm btn-outline-primary">Sửa</a>@if (supplier.IsActive) { <form asp-action="SupplierDeactivate" asp-route-id="@supplier.SupplierId" method="post" onsubmit="return confirm('Ngừng hợp tác với nhà cung cấp này?')"><button class="btn btn-sm btn-outline-danger">Ngừng</button></form> }</div></td></tr>
}
</tbody></table></div></section>
