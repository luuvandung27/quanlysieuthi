@model QuanLySieuThi.Models.EmployeeAccountFormViewModel
@{ ViewData["Title"] = "Thêm nhân viên"; }
<div class="page-heading"><div><p class="eyebrow">QUẢN TRỊ NGƯỜI DÙNG</p><h1>Thêm nhân viên</h1><p class="text-muted">Tạo tài khoản Thu ngân hoặc Nhân viên kho theo công việc được giao.</p></div><a asp-action="Employees" class="btn btn-outline-secondary">← Danh sách nhân viên</a></div>
<section class="panel form-panel"><form asp-action="EmployeeCreate" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
    <div class="form-grid">
        <div>
            <label asp-for="RoleName" class="form-label">Vai trò</label>
            <select asp-for="RoleName" class="form-select">
                <option value="">Chọn vai trò</option>
                <option value="@RoleNames.Cashier">Thu ngân</option>
                <option value="@RoleNames.StockStaff">Nhân viên kho</option>
            </select>
            <span asp-validation-for="RoleName" class="text-danger"></span>
        </div>
        <div><label asp-for="EmployeeCode" class="form-label"></label><input asp-for="EmployeeCode" class="form-control" placeholder="NV0001" /><span asp-validation-for="EmployeeCode" class="text-danger small"></span></div>
        <div><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger small"></span></div>
        <div><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /></div>
        <div><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger small"></span></div>
        <div><label asp-for="Position" class="form-label"></label><input asp-for="Position" class="form-control" placeholder="Thu ngân, nhân viên kho..." /></div>
        <div><label asp-for="Username" class="form-label"></label><input asp-for="Username" class="form-control" autocomplete="off" /><span asp-validation-for="Username" class="text-danger small"></span></div>
        <div><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger small"></span><small class="text-muted">Mật khẩu được băm trước khi lưu.</small></div>
    </div>
    <div class="d-flex justify-content-end gap-2 mt-4"><a asp-action="Employees" class="btn btn-outline-secondary">Hủy</a><button class="btn btn-primary" type="submit">Tạo tài khoản</button></div>
</form><partial name="_ValidationScriptsPartial" /></section>
