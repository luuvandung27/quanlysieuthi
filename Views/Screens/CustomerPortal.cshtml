@{ ViewData["Title"] = "Tài khoản khách hàng"; }
<div class="page-heading"><div><p class="eyebrow">TÀI KHOẢN CỦA TÔI</p><h1>Xin chào, @User.Identity?.Name</h1><p class="text-muted">Theo dõi các giao dịch và thông tin tài khoản của bạn.</p></div></div>
<section class="metric-grid three-metrics"><article class="metric-card"><div class="metric-top"><span>Hóa đơn đã mua</span><span class="metric-icon blue">▣</span></div><strong>0</strong><small>Hóa đơn sẽ hiển thị sau khi tài khoản được liên kết khách hàng.</small></article><article class="metric-card"><div class="metric-top"><span>Điểm tích lũy</span><span class="metric-icon violet">✦</span></div><strong>0</strong><small>Chương trình khách hàng thân thiết sẽ được bổ sung.</small></article><article class="metric-card"><div class="metric-top"><span>Hồ sơ</span><span class="metric-icon green">♙</span></div><strong>Đang hoạt động</strong><small>Tài khoản khách hàng</small></article></section>
<section class="panel"><div class="panel-heading"><div><h2>Lịch sử mua hàng</h2><p>Hóa đơn được liên kết với tài khoản của bạn</p></div></div><div class="empty-state"><span>▧</span><strong>Chưa có giao dịch</strong><p>Khi hóa đơn được liên kết với tài khoản, lịch sử mua hàng sẽ hiển thị tại đây.</p></div></section>
