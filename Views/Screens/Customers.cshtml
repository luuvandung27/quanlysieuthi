@model IReadOnlyList<QuanLySieuThi.Models.Entities.Customer>
@{ ViewData["Title"] = "Khách hàng"; }

<div class="page-heading">
    <div><h1>Khách hàng</h1><p class="text-muted">Tra cứu và cập nhật thông tin khách hàng.</p></div>
    <a asp-action="CustomerForm" class="btn btn-primary">Thêm khách hàng</a>
</div>
<section class="panel table-panel">
    <form asp-action="Customers" method="get" class="toolbar">
        <label for="customer-search" class="visually-hidden">Tìm khách hàng</label>
        <input id="customer-search" class="form-control" name="search" value="@ViewData["Search"]" placeholder="Tên, mã khách hàng hoặc số điện thoại" />
        <button class="btn btn-outline-secondary">Tìm kiếm</button>
    </form>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead><tr><th>Mã khách hàng</th><th>Họ tên</th><th>Điện thoại</th><th>Email</th><th></th></tr></thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="5">Không tìm thấy khách hàng.</td></tr>
                }
                @foreach (var customer in Model)
                {
                    <tr>
                        <td>@customer.CustomerCode</td><td>@customer.FullName</td><td>@customer.Phone</td><td>@customer.Email</td>
                        <td><a asp-action="CustomerForm" asp-route-id="@customer.CustomerId">Sửa</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
